<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ====================================================================
         CVE-2026-29062 – tools.jackson.core / Jackson 3.x false positive
         Upgrading to Jackson 3.1.0+ causes ExceptionInInitializerError
         (NoClassDefFoundError) due to a framework mismatch with Jackson 2.x
         annotations expecting JsonSerializeAs.
         Waiting for Spring Boot upstream upgrade.
         ==================================================================== -->
    <suppress>
        <notes>
            Suppress CVE-2026-29062 for tools.jackson.core on Spring Boot 4.0.3.
            Upgrading to Jackson 3.1.0+ causes ExceptionInInitializerError (NoClassDefFoundError)
            due to a framework mismatch with Jackson 2.x annotations expecting JsonSerializeAs.
            Waiting for Spring Boot upstream upgrade.
        </notes>
        <packageUrl regex="true">^pkg:maven/tools\.jackson\.core/jackson-.*@.*$</packageUrl>
        <cve>CVE-2026-29062</cve>
    </suppress>

    <!-- ====================================================================
         Swagger-UI bundle – all CVEs (DOMPurify, etc.)
         The vulnerabilities reported inside the swagger-ui JAR bundle
         (DOMPurify mXSS: CVE-2025-26791, CVE-2026-0540, CVE-2025-15599, …)
         are only exploitable when an attacker can control the HTML fed to
         DOMPurify AND the application re-inserts that output into a special
         wrapper context (script, xmp, iframe …) via innerHTML.
         Swagger-UI is used solely for developer documentation endpoints and
         is disabled in production; the risk is accepted.
         ==================================================================== -->
    <suppress>
        <notes>
            Suppress all vulnerabilities reported within swagger-ui bundles.
            DOMPurify mXSS CVEs (CVE-2025-26791, CVE-2026-0540, CVE-2025-15599, etc.)
            are only reachable through a deliberate developer-facing UI,
            not through any production attack surface.
        </notes>
        <filePath regex="true">.*swagger-ui.*</filePath>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ====================================================================
         DOMPurify pkg:javascript – fallback pkg-url matcher
         Same rationale as above; catches the javascript package-url variant
         that ODC reports independently of the JAR file path.
         ==================================================================== -->
    <suppress>
        <notes>Fallback URL matcher for DOMPurify within Swagger UI – see rationale above.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

</suppressions>
